<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="content" method="upgrade">
    <name>PLG_DJCLASSIFIEDS_PREMIUMCOMPANIES</name>
    <author>Claude AI</author>
    <creationDate>2026-01</creationDate>
    <copyright>Copyright (C) 2026. All rights reserved.</copyright>
    <license>GNU General Public License version 2 or later</license>
    <authorEmail>noreply@anthropic.com</authorEmail>
    <authorUrl>https://www.anthropic.com</authorUrl>
    <version>1.0.0</version>
    <description>PLG_DJCLASSIFIEDS_PREMIUMCOMPANIES_XML_DESCRIPTION</description>

    <files>
        <filename plugin="premiumcompanies">premiumcompanies.php</filename>
        <folder>language</folder>
        <folder>assets</folder>
    </files>

    <languages>
        <language tag="en-GB">language/en-GB/plg_djclassifieds_premiumcompanies.ini</language>
        <language tag="ru-RU">language/ru-RU/plg_djclassifieds_premiumcompanies.ini</language>
    </languages>

    <scriptfile>script.php</scriptfile>

    <config>
        <fields name="params">
            <fieldset name="basic" label="PLG_DJCLASSIFIEDS_PREMIUMCOMPANIES_BASIC_SETTINGS">
                <field
                    name="target_urls"
                    type="textarea"
                    label="PLG_DJCLASSIFIEDS_PREMIUMCOMPANIES_TARGET_URLS_LABEL"
                    description="PLG_DJCLASSIFIEDS_PREMIUMCOMPANIES_TARGET_URLS_DESC"
                    rows="5"
                    cols="50"
                    filter="raw"
                    hint="/index.php?option=com_djclassifieds&amp;view=additem"
                />

                <field
                    name="max_companies"
                    type="number"
                    label="PLG_DJCLASSIFIEDS_PREMIUMCOMPANIES_MAX_COMPANIES_LABEL"
                    description="PLG_DJCLASSIFIEDS_PREMIUMCOMPANIES_MAX_COMPANIES_DESC"
                    default="10"
                    min="1"
                    max="50"
                    step="1"
                />

                <field
                    name="show_all_companies"
                    type="radio"
                    label="PLG_DJCLASSIFIEDS_PREMIUMCOMPANIES_SHOW_ALL_LABEL"
                    description="PLG_DJCLASSIFIEDS_PREMIUMCOMPANIES_SHOW_ALL_DESC"
                    default="1"
                    class="btn-group btn-group-yesno"
                >
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>

                <field
                    name="match_by_category"
                    type="radio"
                    label="PLG_DJCLASSIFIEDS_PREMIUMCOMPANIES_MATCH_CATEGORY_LABEL"
                    description="PLG_DJCLASSIFIEDS_PREMIUMCOMPANIES_MATCH_CATEGORY_DESC"
                    default="1"
                    class="btn-group btn-group-yesno"
                >
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>

                <field
                    name="show_position"
                    type="list"
                    label="PLG_DJCLASSIFIEDS_PREMIUMCOMPANIES_POSITION_LABEL"
                    description="PLG_DJCLASSIFIEDS_PREMIUMCOMPANIES_POSITION_DESC"
                    default="before"
                >
                    <option value="before">PLG_DJCLASSIFIEDS_PREMIUMCOMPANIES_POSITION_BEFORE</option>
                    <option value="after">PLG_DJCLASSIFIEDS_PREMIUMCOMPANIES_POSITION_AFTER</option>
                </field>

                <field
                    name="display_style"
                    type="list"
                    label="PLG_DJCLASSIFIEDS_PREMIUMCOMPANIES_STYLE_LABEL"
                    description="PLG_DJCLASSIFIEDS_PREMIUMCOMPANIES_STYLE_DESC"
                    default="cards"
                >
                    <option value="cards">PLG_DJCLASSIFIEDS_PREMIUMCOMPANIES_STYLE_CARDS</option>
                    <option value="list">PLG_DJCLASSIFIEDS_PREMIUMCOMPANIES_STYLE_LIST</option>
                    <option value="compact">PLG_DJCLASSIFIEDS_PREMIUMCOMPANIES_STYLE_COMPACT</option>
                </field>

                <field
                    name="show_logo"
                    type="radio"
                    label="PLG_DJCLASSIFIEDS_PREMIUMCOMPANIES_SHOW_LOGO_LABEL"
                    description="PLG_DJCLASSIFIEDS_PREMIUMCOMPANIES_SHOW_LOGO_DESC"
                    default="1"
                    class="btn-group btn-group-yesno"
                >
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>

                <field
                    name="custom_css"
                    type="textarea"
                    label="PLG_DJCLASSIFIEDS_PREMIUMCOMPANIES_CUSTOM_CSS_LABEL"
                    description="PLG_DJCLASSIFIEDS_PREMIUMCOMPANIES_CUSTOM_CSS_DESC"
                    rows="5"
                    cols="50"
                    filter="raw"
                />
            </fieldset>

            <fieldset name="ai_settings" label="PLG_DJCLASSIFIEDS_PREMIUMCOMPANIES_AI_SETTINGS">
                <field
                    name="enable_chatgpt"
                    type="radio"
                    label="PLG_DJCLASSIFIEDS_PREMIUMCOMPANIES_ENABLE_AI_LABEL"
                    description="PLG_DJCLASSIFIEDS_PREMIUMCOMPANIES_ENABLE_AI_DESC"
                    default="0"
                    class="btn-group btn-group-yesno"
                >
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>

                <field
                    name="chatgpt_api_key"
                    type="text"
                    label="PLG_DJCLASSIFIEDS_PREMIUMCOMPANIES_API_KEY_LABEL"
                    description="PLG_DJCLASSIFIEDS_PREMIUMCOMPANIES_API_KEY_DESC"
                    size="50"
                    filter="raw"
                    showon="enable_chatgpt:1"
                />

                <field
                    name="chatgpt_model"
                    type="list"
                    label="PLG_DJCLASSIFIEDS_PREMIUMCOMPANIES_AI_MODEL_LABEL"
                    description="PLG_DJCLASSIFIEDS_PREMIUMCOMPANIES_AI_MODEL_DESC"
                    default="gpt-4o-mini"
                    showon="enable_chatgpt:1"
                >
                    <option value="gpt-4o-mini">GPT-4o Mini (Recommended)</option>
                    <option value="gpt-4o">GPT-4o</option>
                    <option value="gpt-4-turbo">GPT-4 Turbo</option>
                    <option value="gpt-3.5-turbo">GPT-3.5 Turbo</option>
                </field>

                <field
                    name="ai_max_results"
                    type="number"
                    label="PLG_DJCLASSIFIEDS_PREMIUMCOMPANIES_AI_MAX_RESULTS_LABEL"
                    description="PLG_DJCLASSIFIEDS_PREMIUMCOMPANIES_AI_MAX_RESULTS_DESC"
                    default="5"
                    min="1"
                    max="20"
                    step="1"
                    showon="enable_chatgpt:1"
                />
            </fieldset>
        </fields>
    </config>
</extension>
